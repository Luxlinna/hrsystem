{
  "name": "hrsystem-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n \"CLIENT,SERVER\" -c \"cyan,magenta\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:frontend": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:backend": "npm --prefix server run dev",
    "dev:all": "npm run dev",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:frontend": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:backend": "npm --prefix server run build",
    "build:all": "npm --prefix client run build && npm --prefix server run build",
    "preview": "npm --prefix client run preview",
    "start": "node serve.mjs",
    "backup:s3": "node scripts/backup-db-to-s3.mjs",
    "restore:s3": "node scripts/restore-db-from-s3.mjs",
    "zkteco:sync": "node scripts/zkteco-sync-agent.mjs",
    "lint": "npm --prefix client run lint",
    "type": "npm run type:all",
    "type:all": "npm --prefix client run type-check && npm --prefix server run type-check",
    "type:client": "npm --prefix client run type-check",
    "type:server": "npm --prefix server run type-check",
    "type-check": "npm run type:all"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "braces": ">=3.0.3",
    "micromatch": ">=4.0.8",
    "protobufjs": ">=7.4.0",
    "@grpc/grpc-js": ">=1.13.6"
  }
}
