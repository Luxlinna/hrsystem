DIRECT_URL="postgresql://postgres.mltkqbcjavgfclitgvin:[YOUR-TEST-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Server ──────────────────────────────────────────────────
