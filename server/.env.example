# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Server Configuration
PORT=4000
NODE_ENV=development

# Supabase Auth & Storage Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="HRSystem <your-email@gmail.com>"
QUOTE_EMAIL_TO=hrsystem.ops@gmail.com

# AWS S3 Storage
AWS_S3_BUCKET=hrsystem-ops
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Cloudflare R2 Storage & CDN
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=hr-documents
CDN_PUBLIC_URL=https://cdn.your-domain.com

# Redis Caching Layer (L2 Cache & Rate Limiting)
# For Managed Cloud Redis (Upstash, AWS ElastiCache, Render, Heroku, Redis Cloud):
REDIS_URL="redis://default:[PASSWORD]@[HOST]:6379"
# For Cloud Redis with SSL/TLS (e.g. Upstash, AWS TLS):
# REDIS_URL="rediss://default:[PASSWORD]@[HOST]:6379"
# REDIS_TLS=true
# REDIS_TLS_REJECT_UNAUTHORIZED=false

# Or standalone parameters:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# DISABLE_EMBEDDED_REDIS=true

