{
  "name": "hrsystem-backend",
  "version": "1.0.0",
  "private": true,
  "description": "HRMS Backend API using Express, Prisma, MVC, and Repository Pattern",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "type": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "start": "node dist/server.js",
    "make:resource": "tsx scripts/make-resource.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/nodemailer": "^8.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "prisma": "^6.4.0",
    "redis-memory-server": "^0.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": ">=8.0.0",
    "mysql2": ">=3.24.0"
  }
}
